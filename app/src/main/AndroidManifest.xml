<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app intentionally enumerates installed apps for per-app fan rules. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:description="@string/app_description"
        android:hasCode="true"
        android:icon="@drawable/ic_cooling_fan"
        android:roundIcon="@drawable/ic_cooling_fan"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".ui.FanAppsActivity"
            android:exported="true"
            android:label="@string/per_app_fan_config_title"
            android:theme="@style/Theme.FanUltra" />
    </application>
</manifest>
